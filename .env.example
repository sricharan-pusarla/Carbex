# ==============================================================================
# CARBEX ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Database Connection (PostgreSQL with btree_gist and pgcrypto extensions)
DATABASE_URL="postgresql://username:password@host:5432/carbex?sslmode=require"

# NextAuth Authentication
NEXTAUTH_SECRET="generate_a_random_32_byte_secret_here"
NEXTAUTH_URL="http://localhost:3000"

# Public Application Base URL (used in email dashboard links)
APP_URL="http://localhost:3000"

# ==============================================================================
# EMAIL NOTIFICATIONS CONFIGURATION
# ==============================================================================

# Administrator Notification Recipient
# The designated email address that receives alerts whenever a new project verification
# request is submitted by a seller.
# Default: sricharanpusarla@gmail.com
ADMIN_NOTIFICATION_EMAIL="sricharanpusarla@gmail.com"

# Sender Identity
# NOTE: Must be authorized by your SMTP provider.
# - If using Gmail: Must match your Gmail address (e.g., yourname@gmail.com)
# - If using Resend: Use "onboarding@resend.dev" for testing or your verified domain
# - If using SendGrid: Must be a verified sender identity in your SendGrid console
EMAIL_FROM="notifications@carbex.demo"
EMAIL_FROM_NAME="Carbex Carbon Exchange"

# ==============================================================================
# REAL SMTP PROVIDER CREDENTIALS
# ==============================================================================
# If SMTP credentials are NOT provided, Carbex logs development previews to the
# console and strictly reports that real delivery was not executed.
# Real inboxes (Gmail, Outlook, etc.) will ONLY receive messages once valid SMTP
# credentials are configured below.

# ------------------------------------------------------------------------------
# OPTION 1: GMAIL SMTP (Recommended for personal Gmail accounts)
# ------------------------------------------------------------------------------
# Requirements:
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Enter App Name "Carbex" and copy the 16-letter password (without spaces).
#
# SMTP_SERVICE="gmail"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASSWORD="your-16-char-app-password"
# EMAIL_FROM="your-email@gmail.com"

# ------------------------------------------------------------------------------
# OPTION 2: RESEND SMTP (Recommended for custom domains & production)
# ------------------------------------------------------------------------------
# Requirements:
# 1. Sign up at https://resend.com (free 3,000 emails/month).
# 2. Create an API key at https://resend.com/api-keys.
# 3. For custom domains, add DNS records (SPF: TXT, DKIM: CNAME, DMARC: TXT).
#
# SMTP_HOST="smtp.resend.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="resend"
# SMTP_PASSWORD="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# EMAIL_FROM="onboarding@resend.dev" # or "notifications@yourdomain.com"

# ------------------------------------------------------------------------------
# OPTION 3: SENDGRID SMTP
# ------------------------------------------------------------------------------
# Requirements:
# 1. Create an API key with "Mail Send" permissions in SendGrid.
# 2. Verify your Sender Identity in SendGrid settings.
#
# SMTP_HOST="smtp.sendgrid.net"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="apikey"
# SMTP_PASSWORD="SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# EMAIL_FROM="verified-sender@yourdomain.com"

# ------------------------------------------------------------------------------
# OPTION 4: GENERIC / CUSTOM SMTP (Amazon SES, Brevo, Mailgun, Postmark)
# ------------------------------------------------------------------------------
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="your-smtp-username"
# SMTP_PASSWORD="your-smtp-password"
